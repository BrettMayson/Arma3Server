ARMA_BINARY=./arma3server_x64
ARMA_CDLC=
ARMA_CONFIG=main.cfg
ARMA_LIMITFPS=100
ARMA_PARAMS=
ARMA_PROFILE=main
ARMA_WORLD=empty
HEADLESS_CLIENTS=0
HEADLESS_CLIENTS_PROFILE="\$profile-hc-\$i" # valid placeholders: $profile, $i, $ii
MODS_LOCAL=true
MODS_PRESET=
PORT=2302
STEAM_BRANCH=public
STEAM_BRANCH_PASSWORD=
STEAM_PASSWORD=password
STEAM_USER=id-not-email
# bind to all interfaces by default, or bind to a specific interface only
HOST_IP=0.0.0.0
# Steam download settings
# The number of concurrent downloads per workshop/depot item. Adjust based on network and disk performance.
ARMA_DOWNLOAD_MAX_WORKERS=4
# Buffer size for each download chunk in bytes. Default is 4 MiB (4194304 bytes).
ARMA_DOWNLOAD_CHUNK_SIZE=4194304
# Download tasks usually don't report progress, but long-running downloads report progress every X seconds. Set to -1 to disable progress reporting.
ARMA_DOWNLOAD_PROGRESS_INTERVAL=60
# Internal retry settings for CDN client and operations. Adjust based on network reliability and expected transient errors.
ARMA_CDN_CLIENT_RETRIES=3
ARMA_CDN_CLIENT_BASE_DELAY=1.5
ARMA_CDN_OP_RETRIES=3
ARMA_CDN_OP_BASE_DELAY=1.5
